<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reportes y Estadísticas"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginBottom="16dp"/>

        <!-- Resumen -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resumen General"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tv_total_animales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_total_ventas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#1565C0"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_total_gastos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#D32F2F"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_ganancias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_animales_vendidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Gráfica Razas -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distribución por Raza"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="8dp"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pie_chart_razas"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- Gráfica Sexo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distribución por Sexo"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="8dp"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pie_chart_sexo"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"/>

                <!-- Leyenda manual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="#1565C0"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tv_machos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#374151"
                        android:layout_marginEnd="16dp"/>

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="#E91E63"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tv_hembras"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#374151"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- Gráfica Producción -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Producción Lechera del Mes"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="8dp"/>

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/bar_chart_produccion"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Gráfica Gastos por Categoría -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gastos por Categoría (mes actual)"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="8dp"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pie_chart_gastos"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"/>

                <TextView
                    android:id="@+id/tv_sin_gastos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin gastos registrados este mes"
                    android:textAlignment="center"
                    android:textColor="#9CA3AF"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
